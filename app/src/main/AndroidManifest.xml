<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Hápticos (M0.8). Permiso normal: no se le pide al usuario. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- tiempo-fuera-api (M1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Avisos de racha e hitos de uso (M3.1, M12). Se pide con el diálogo del sistema (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Medir el uso de apps (M3.4). El usuario lo da en Ajustes → Acceso al uso (M3.1). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Nombres e íconos de las apps con ícono en el launcher, sin pedir QUERY_ALL_PACKAGES
         (que Play revisa aparte). Basta para el selector de apps (M3.2). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TiempoFueraApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TiempoFuera">

        <!-- WorkManager se arranca en TiempoFueraApp con la fábrica de Hilt (M1.5). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Para compartir la imagen de una recompensa (M7.8). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos_compartidos" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Mismo esquema que iOS (ringo://id-mision/<id>) para compartir enlaces
                 desde notificaciones y el API. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ringo" android:host="id-mision" />
            </intent-filter>
        </activity>
        <!-- Notificaciones programadas (M12). -->
        <receiver
            android:name=".core.notificaciones.ReceptorNotificacion"
            android:exported="false" />

        <!-- Bloqueo de apps (M3.5). -->
        <service
            android:name=".servicios.bloqueo.ServicioBloqueo"
            android:exported="true"
            android:label="@string/servicio_bloqueo_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/servicio_bloqueo" />
        </service>
    </application>
</manifest>
